{
  "name": "octora-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "imports": {
    "#app": "./src/app.js",
    "#common/*": [
      "./src/common/*.js",
      "./src/common/*/index.js"
    ],
    "#domain": "./src/domain/index.js",
    "#domain/*": [
      "./src/domain/*.js",
      "./src/domain/*/index.js"
    ],
    "#modules/*": [
      "./src/modules/*.js",
      "./src/modules/*/index.js"
    ],
    "#infra/*": [
      "./src/infra/*.js",
      "./src/infra/*/index.js"
    ],
    "#test-kit": "./src/test-kit/index.js",
    "#test-kit/*": [
      "./src/test-kit/*.js",
      "./src/test-kit/*/index.js"
    ],
    "#workers": "./src/workers/index.js",
    "#workers/*": [
      "./src/workers/*.js",
      "./src/workers/*/index.js"
    ]
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts | pino-pretty",
    "seed:demo": "tsx --env-file=.env src/scripts/seed-demo-data.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && node scripts/check-process-env.mjs && node scripts/check-prisma-imports.mjs",
    "lint:env": "node scripts/check-process-env.mjs",
    "lint:prisma": "node scripts/check-prisma-imports.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@meteora-ag/dlmm": "^1.9.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/fastify-api-reference": "^1.53.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "fastify": "^5.3.0",
    "fixed-merkle-tree": "^0.7.3",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "resend": "^6.12.2",
    "snarkjs": "^0.7.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/snarkjs": "^0.7.9",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "underscore@<1.13.8": "^1.13.8",
      "uuid@>=11.0.0 <11.1.1": "^11.1.1",
      "@hono/node-server@<1.19.13": "^1.19.13"
    }
  }
}

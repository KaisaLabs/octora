# =============================================================================
# octora-api environment variables — copy to .env and fill in values.
# =============================================================================

# --- Server ---
PORT=8787
FRONTEND_URL=http://localhost:3000

# --- Database ---
# Local Docker PostgreSQL (see infra/docker-compose.dev.yml):
DATABASE_URL=postgresql://octora:octora@localhost:5432/octora
# Production (Supabase): use the direct connection (5432), not the pgbouncer
# pooler (6543), for Prisma migrations.

# --- Email (Resend) ---
RESEND_API_KEY=
# EMAIL_FROM="Octora <hello@octora.xyz>"

# --- Solana RPC ---
SOLANA_RPC_URL=http://127.0.0.1:8899

# --- Programs ---
OCTORA_EXECUTOR_PROGRAM_ID=
OCTORA_MIXER_PROGRAM_ID=

# --- Keypairs (filesystem paths, or file:/abs/path for hot wallet) ---
OCTORA_MIXER_ADMIN_KEYPAIR=
OCTORA_EXECUTOR_RELAYER_KEYPAIR=
OCTORA_MIXER_RELAYER_HOT_WALLET=

# --- Mixer ---
OCTORA_MIXER_PRIVACY_DELAY_MS=0
OCTORA_MIXER_POOL_DENOMINATION=1000000000
MIXER_MIN_ANONYMITY_SET=20

# --- Mixer relayer ---
OCTORA_MIXER_RELAYER_ENABLED=true
OCTORA_MIXER_RELAYER_RPC_URL=http://127.0.0.1:8899
OCTORA_MIXER_RELAYER_MIN_FEE=10000
OCTORA_MIXER_RELAYER_DENOMINATIONS=100000000,1000000000,5000000000,10000000000

# =============================================================================
# Optional — defaults exist in src/common/config. Uncomment to override.
# =============================================================================
# LOG_LEVEL=info
# NODE_ENV=development
# OCTORA_USE_ONCHAIN_EXECUTOR=true
# OCTORA_HOT_WALLET_DIR=
# OCTORA_ADMIN_API_TOKEN=
# OCTORA_RECOVERY_WORKER_ENABLED=true

# --- Rate limiting / Redis ---
# RATE_LIMITER=memory
# REDIS_URL=redis://localhost:6379

# --- Observability ---
# SENTRY_DSN=
# OTEL_SERVICE_NAME=octora-api
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- DB pool tuning ---
# OCTORA_DB_POOL_MIN=2
# OCTORA_DB_POOL_MAX=10
# OCTORA_DB_POOL_IDLE_MS=30000
# OCTORA_DB_STATEMENT_TIMEOUT_MS=30000
# OCTORA_DB_PGBOUNCER_MODE=transaction

# --- HTTP circuit breaker ---
# OCTORA_HTTP_BREAKER_FAILURE_THRESHOLD=5
# OCTORA_HTTP_BREAKER_WINDOW_MS=60000
# OCTORA_HTTP_BREAKER_COOLDOWN_MS=30000

# --- Meteora pool cache ---
# OCTORA_METEORA_POOL_CACHE_TTL_MS=60000
# OCTORA_METEORA_POOL_CACHE_MAX=100

# --- DLMM constants ---
# OCTORA_DLMM_PROGRAM_ID=
# OCTORA_DLMM_EVENT_AUTHORITY=
# OCTORA_DLMM_BASE_FACTOR=
# OCTORA_DLMM_BIN_STEP=
# OCTORA_DLMM_PRESET_PARAMETER=
# OCTORA_DLMM_RPC_URL_LOCALNET=http://127.0.0.1:8899
# OCTORA_DLMM_RPC_URL_DEVNET=https://api.devnet.solana.com
# OCTORA_DLMM_RPC_URL_MAINNET=https://api.mainnet-beta.solana.com

# --- Beta caps ---
# BETA_MAX_GLOBAL_TVL_SOL=
# BETA_MAX_POSITION_SOL=
# BETA_MAX_POSITIONS_PER_WALLET=

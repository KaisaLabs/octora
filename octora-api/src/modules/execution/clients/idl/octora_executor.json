  "types": [
    {
      "name": "Config",
      "docs": [
        "Global executor config — emergency pause + admin authority.",
        "",
        "Mirrors `octora-mixer`'s pause model so that a DLMM/DAMM CPI bug or",
        "upstream Meteora incident can halt every state-mutating instruction",
        "from a single multisig signature, without requiring a program upgrade.",
        "",
        "PDA seeds: `[b\"config\"]` — single global account."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "docs": [
              "Key authorized to flip `paused`. Set once at `init_config` and",
              "thereafter only this key can call `set_paused`. Should be a Squads",
              "(or equivalent) multisig PDA on mainnet."
            ],
            "type": "pubkey"
          },
          {
            "name": "paused",
            "docs": [
              "When true, every state-mutating executor instruction fails closed."
            ],
            "type": "bool"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump."
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "PoolAuthority",
      "docs": [
        "PDA that owns a pool position on behalf of a stealth wallet.",
        "",
        "Works for both DLMM and DAMM pools. The PDA is derived from",
        "[POOL_AUTHORITY_SEED, stealth_pubkey, pool_pubkey]."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "stealth_pubkey",
            "type": "pubkey"
          },
          {
            "name": "exit_recipient",
            "type": "pubkey"
          },
          {
            "name": "pool_ref",
            "type": {
              "defined": {
                "name": "PoolRef"
              }
            }
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "PoolRef",
      "docs": [
        "Identifies which pool type a PoolAuthority references."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Dlmm",
            "fields": [
              {
                "name": "lb_pair",
                "type": "pubkey"
              },
              {
                "name": "position",
                "type": "pubkey"
              }
            ]
          },
          {
            "name": "Damm",
            "fields": [
              {
                "name": "pool",
                "type": "pubkey"
              },
              {
                "name": "lp_mint",
                "type": "pubkey"
              },
              {
                "name": "lock_escrow",
                "type": "pubkey"
              }
            ]
          }
        ]
      }
    }
  ]

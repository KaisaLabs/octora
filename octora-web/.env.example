# =============================================================================
# octora-web environment variables — copy to .env and fill in values.
# Vite exposes only vars prefixed with VITE_ to client code.
# =============================================================================

# --- Backend API ---
VITE_API_URL=http://localhost:8787

# --- Cluster ---
# One of: mainnet | devnet | localnet. Required in production builds.
VITE_NETWORK=devnet

# --- Solana RPC ---
# VITE_RPC_URL is read by mixer/lifecycle flows (PrivateDepositModal, etc.).
# VITE_SOLANA_RPC_URL / VITE_SOLANA_WS_URL are read by the wallet/connection
# layer in src/lib/solana/config.ts.
VITE_RPC_URL=http://127.0.0.1:8899
VITE_SOLANA_RPC_URL=http://127.0.0.1:8899
VITE_SOLANA_WS_URL=ws://127.0.0.1:8900

# =============================================================================
# Optional — uncomment to enable.
# =============================================================================
# VITE_SENTRY_DSN=
# VITE_RELEASE=
